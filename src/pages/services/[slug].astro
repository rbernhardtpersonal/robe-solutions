---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import { services } from '../../data/services';
import { stack } from '../../data/stack';

export function getStaticPaths() {
	return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const stackLinks = service.stack.map((name) => stack.find((item) => item.name === name));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const root = `${base}/`;
---

<Layout title={`${service.name} | Robe Solutions`}>
	<SiteHeader />
	<main class="service-page">
		<section class="service-hero">
			<div><p class="eyebrow">{service.number} / Robe Solutions services</p><h1>{service.name}</h1><p class="lead">{service.description}</p><a class="button" href={`${root}#contact`}>Talk about your project <span>↗</span></a></div>
			<ImagePlaceholder imageName={`${service.slug}.jpg`} alt={`${service.name} project detail`} label="IMAGE / PROJECT DETAIL" />
		</section>
		<section class="service-details">
			<div class="section-kicker">What this includes</div>
			<div class="details-content"><h2>Built for the<br /><em>work ahead.</em></h2><div class="points">{service.points.map((point, index) => <div><span>0{index + 1}</span><p>{point}</p></div>)}<div class="stack-row"><span>STACK</span><p>{stackLinks.map((item, index) => item && <><a href={`${root}stack/${item.slug}`}>{item.name}</a>{index < stackLinks.length - 1 && ' / '}</>)}</p></div></div></div>
		</section>
		<section class="next-step"><p class="eyebrow">One connected partner</p><h2>Good data work<br /><em>compounds.</em></h2><a class="text-link" href={root}>Explore all services <span>↗</span></a></section>
	</main>
	<footer><a href={root} class="logo"><span>R</span> robe<span class="dot">.</span></a><span>© 2026 Robe Solutions</span></footer>
</Layout>

<style>
	.service-page { max-width: 1240px; margin: 0 auto; padding: 85px 32px 0; }.service-hero { display: grid; grid-template-columns: 1.05fr .95fr; gap: 100px; align-items: center; min-height: 500px; }.eyebrow, .section-kicker { margin: 0 0 24px; color: #c9f85b; text-transform: uppercase; letter-spacing: 1.5px; font: 700 11px 'DM Sans', sans-serif; }.service-hero h1 { max-width: 680px; margin: 0 0 28px; color: #f4f4ed; font: 500 clamp(54px, 7vw, 94px)/.93 'Space Grotesk', sans-serif; letter-spacing: -4px; }.lead { max-width: 510px; color: #a5aaa1; font-size: 18px; line-height: 1.6; }.button { display: inline-flex; margin-top: 23px; padding: 15px 18px; background: #c9f85b; color: #101212; text-decoration: none; font-size: 13px; font-weight: 700; }.button span, .text-link span { margin-left: 8px; color: #101212; }.image-placeholder { min-height: 330px; display: flex; flex-direction: column; justify-content: end; padding: 25px; background: repeating-linear-gradient(135deg, #1b201d, #1b201d 2px, #202621 2px, #202621 4px); border: 1px solid #3a4239; box-shadow: 20px 20px 0 rgba(201,248,91,.08); }.image-placeholder span { margin-bottom: auto; color: #697269; font: 600 9px 'Space Grotesk', sans-serif; letter-spacing: 1.3px; }.image-placeholder strong { color: #f4f4ed; font: 500 25px 'Space Grotesk', sans-serif; }.image-placeholder small { max-width: 240px; margin-top: 10px; color: #8c968a; line-height: 1.5; }.image-placeholder code { color: #c9f85b; }.service-details { padding: 140px 0; border-top: 1px solid #2d322f; margin-top: 120px; display: grid; grid-template-columns: 1fr 2fr; gap: 80px; }.details-content { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; }.details-content h2, .next-step h2 { margin: -8px 0 0; color: #f4f4ed; font: 500 clamp(40px, 5vw, 67px)/.96 'Space Grotesk', sans-serif; letter-spacing: -3px; }.details-content em, .next-step em { color: #c9f85b; font-style: normal; }.points div { display: flex; gap: 20px; padding: 16px 0; border-top: 1px solid #3b433a; }.points span { color: #697269; font: 11px 'Space Grotesk', sans-serif; }.points p { margin: 0; color: #d4d8cf; font-size: 14px; }.stack-row a { color: #c9f85b; text-decoration: none; }.stack-row a:hover { text-decoration: underline; }.next-step { padding: 90px 0 120px; border-top: 1px solid #2d322f; }.next-step h2 { margin-bottom: 35px; }.text-link { color: #f4f4ed; text-decoration: none; font-size: 13px; font-weight: 700; }.text-link span { color: #c9f85b; }.service-page + footer { max-width: 1240px; margin: 0 auto; padding: 27px 32px; display: flex; justify-content: space-between; color: #697269; font-size: 11px; }.logo { color: #f4f4ed; font: 700 16px 'Space Grotesk', sans-serif; text-decoration: none; }.logo > span:first-child { display: inline-grid; place-items: center; width: 23px; height: 23px; margin-right: 4px; background: #c9f85b; color: #101212; font-size: 13px; }.dot { color: #c9f85b; }
	@media (max-width: 800px) { .service-page { padding: 55px 20px 0; }.service-hero, .service-details, .details-content { display: block; }.service-hero h1 { letter-spacing: -3px; }.image-placeholder { min-height: 270px; margin-top: 65px; }.service-details { margin-top: 85px; padding: 85px 0; }.details-content h2 { margin: 0 0 38px; }.next-step { padding: 70px 0 90px; }.service-page + footer { padding: 25px 20px; } }
</style>
