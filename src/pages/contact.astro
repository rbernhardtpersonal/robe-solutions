---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const root = `${base}/`;
---

<Layout title="Contact | Robe Solutions">
	<SiteHeader />

	<main class="contact-page">
		<section class="contact-hero">
			<div class="contact-intro">
				<p class="eyebrow">Start a conversation</p>
				<h1>Let’s make it<br /><em>legible.</em></h1>
				<p class="lead">Have a difficult data problem, an ambitious idea, or a system that needs a clearer direction? Tell us what you are working through.</p>
				<p class="direct-email">Prefer email? <a href="mailto:hello@robesolutions.com">hello@robesolutions.com <span>↗</span></a></p>
			</div>
			<ImagePlaceholder imageName="Contact_Us.jpg" alt="Illustration of a developer working at a computer" label="IMAGE / YOUR DATA STORY" />
		</section>

		<section class="contact-form-section" aria-labelledby="form-title">
			<div class="section-kicker">01 / Tell us more</div>
			<div class="form-layout">
				<div>
					<h2 id="form-title">What can we<br /><em>help you solve?</em></h2>
					<p>Give us the shape of the challenge. We will get back to you at the address you provide.</p>
				</div>
				<form action="mailto:hello@robesolutions.com" method="post" enctype="text/plain">
					<div class="field-row">
						<label for="first-name">First name<input id="first-name" name="First name" type="text" autocomplete="given-name" required /></label>
						<label for="last-name">Last name<input id="last-name" name="Last name" type="text" autocomplete="family-name" required /></label>
					</div>
					<label for="email">Email<input id="email" name="Email" type="email" autocomplete="email" required /></label>
					<label for="message">How can we help you?<textarea id="message" name="How can we help you?" rows="7" required></textarea></label>
					<button class="button button-primary" type="submit">Send your note <span>↗</span></button>
				</form>
			</div>
		</section>
	</main>

	<footer><a href={root} class="logo"><span>R</span> robe<span class="dot">.</span></a><span>Data, made useful.</span><span>© 2026 Robe Solutions</span></footer>
</Layout>

<style>
	@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');

	:global(*) { box-sizing: border-box; }
	.contact-page { max-width: 1240px; margin: 0 auto; padding: 82px 32px 135px; }
	.contact-hero { display: grid; grid-template-columns: 1fr 1fr; gap: 90px; align-items: end; }
	.eyebrow, .section-kicker { margin: 0 0 22px; text-transform: uppercase; letter-spacing: 1.5px; font-size: 11px; color: #c9f85b; font-weight: 700; }
	h1, h2 { font-family: 'Space Grotesk', sans-serif; }
	h1 { margin: 0 0 32px; color: #f4f4ed; font-size: clamp(58px, 8vw, 108px); line-height: .9; letter-spacing: -5px; }
	h1 em, h2 em { color: #c9f85b; font-style: normal; }
	.lead, .form-layout > div p { max-width: 455px; margin: 0; color: #9ca49a; font-size: 16px; line-height: 1.7; }
	.direct-email { margin: 38px 0 0; color: #697269; font-size: 13px; }
	.direct-email a { color: #f4f4ed; font-weight: 700; text-decoration: none; }
	.direct-email span, .button span { color: #c9f85b; margin-left: 8px; }
	.contact-form-section { margin-top: 135px; padding-top: 30px; border-top: 1px solid #2d322f; }
	.form-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 90px; }
	h2 { margin: -8px 0 25px; color: #f4f4ed; font-size: clamp(39px, 5vw, 67px); line-height: .96; letter-spacing: -3px; }
	form { display: grid; gap: 23px; }
	.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
	label { display: grid; gap: 9px; color: #a5aaa1; font-size: 12px; font-weight: 700; }
	input, textarea { width: 100%; border: 1px solid #4a5149; border-radius: 0; padding: 14px; background: #1a1e1c; color: #f4f4ed; font: 15px 'DM Sans', sans-serif; }
	input:focus, textarea:focus { outline: 2px solid #c9f85b; outline-offset: 2px; }
	textarea { resize: vertical; min-height: 170px; }
	.button { justify-self: start; border: 0; padding: 15px 18px; background: #c9f85b; color: #101212; font: 700 13px 'DM Sans', sans-serif; cursor: pointer; }
	.button span { color: #101212; }
	footer { max-width: 1240px; margin: 0 auto; padding: 27px 32px; display: flex; justify-content: space-between; color: #697269; font-size: 11px; }
	footer .logo { color: #f4f4ed; font: 700 15px 'Space Grotesk', sans-serif; letter-spacing: -1px; text-decoration: none; } footer .logo > span:first-child { display: inline-grid; place-items: center; width: 21px; height: 21px; margin-right: 4px; background: #c9f85b; color: #101212; font-size: 12px; letter-spacing: 0; } footer .dot { color: #c9f85b; }
	@media (max-width: 800px) { .contact-page { padding: 70px 20px 85px; }.contact-hero, .form-layout { display: block; }.image-placeholder { min-height: 300px; margin-top: 65px; }.contact-form-section { margin-top: 90px; }.form-layout > div p { margin-bottom: 40px; }.field-row { grid-template-columns: 1fr; gap: 23px; }footer { padding: 25px 20px; gap: 15px; flex-wrap: wrap; }footer > span:last-child { width: 100%; } }
</style>