---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { stack } from '../../data/stack';

export function getStaticPaths() {
	return stack.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout title={`${item.name} | Robe Solutions`}>
	<SiteHeader />
	<main class="stack-page">
		<section class="stack-hero"><div><p class="eyebrow">{item.number} / Robe Solutions stack</p><h1>{item.name}</h1><p class="lead">{item.description}</p><a class="button" href={`${base}#contact`}>Talk about your environment <span>↗</span></a></div><div class="image-placeholder"><span>PLATFORM / SYSTEM DETAIL</span><strong>Drop a platform image here</strong><small>Add an architecture diagram, product image, or implementation detail to <code>public/images</code>.</small></div></section>
		<section class="stack-details"><div class="section-kicker">Where it fits</div><div class="details-content"><h2>Technology with<br /><em>a purpose.</em></h2><div class="points">{item.usedFor.map((use, index) => <div><span>0{index + 1}</span><p>{use}</p></div>)}</div></div></section>
		<section class="next-step"><p class="eyebrow">The wider environment</p><h2>Systems work<br /><em>better together.</em></h2><a class="text-link" href={`${base}#architecture`}>See a reference architecture <span>↗</span></a></section>
	</main>
	<footer><a href={base} class="logo"><span>R</span> robe<span class="dot">.</span></a><span>© 2026 Robe Solutions</span></footer>
</Layout>

<style>
	.stack-page { max-width: 1240px; margin: 0 auto; padding: 85px 32px 0; }.stack-hero { display: grid; grid-template-columns: 1.05fr .95fr; gap: 100px; align-items: center; min-height: 500px; }.eyebrow, .section-kicker { margin: 0 0 24px; color: #c9f85b; text-transform: uppercase; letter-spacing: 1.5px; font: 700 11px 'DM Sans', sans-serif; }.stack-hero h1 { max-width: 680px; margin: 0 0 28px; color: #f4f4ed; font: 500 clamp(54px, 7vw, 94px)/.93 'Space Grotesk', sans-serif; letter-spacing: -4px; }.lead { max-width: 510px; color: #a5aaa1; font-size: 18px; line-height: 1.6; }.button { display: inline-flex; margin-top: 23px; padding: 15px 18px; background: #c9f85b; color: #101212; text-decoration: none; font-size: 13px; font-weight: 700; }.button span { margin-left: 8px; }.image-placeholder { min-height: 330px; display: flex; flex-direction: column; justify-content: end; padding: 25px; background: repeating-linear-gradient(135deg, #1b201d, #1b201d 2px, #202621 2px, #202621 4px); border: 1px solid #3a4239; box-shadow: 20px 20px 0 rgba(201,248,91,.08); }.image-placeholder span { margin-bottom: auto; color: #697269; font: 600 9px 'Space Grotesk', sans-serif; letter-spacing: 1.3px; }.image-placeholder strong { color: #f4f4ed; font: 500 25px 'Space Grotesk', sans-serif; }.image-placeholder small { max-width: 240px; margin-top: 10px; color: #8c968a; line-height: 1.5; }.image-placeholder code { color: #c9f85b; }.stack-details { padding: 140px 0; border-top: 1px solid #2d322f; margin-top: 120px; display: grid; grid-template-columns: 1fr 2fr; gap: 80px; }.details-content { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; }.details-content h2, .next-step h2 { margin: -8px 0 0; color: #f4f4ed; font: 500 clamp(40px, 5vw, 67px)/.96 'Space Grotesk', sans-serif; letter-spacing: -3px; }.details-content em, .next-step em { color: #c9f85b; font-style: normal; }.points div { display: flex; gap: 20px; padding: 16px 0; border-top: 1px solid #3b433a; }.points span { color: #697269; font: 11px 'Space Grotesk', sans-serif; }.points p { margin: 0; color: #d4d8cf; font-size: 14px; }.next-step { padding: 90px 0 120px; border-top: 1px solid #2d322f; }.next-step h2 { margin-bottom: 35px; }.text-link { color: #f4f4ed; text-decoration: none; font-size: 13px; font-weight: 700; }.text-link span { margin-left: 8px; color: #c9f85b; }.stack-page + footer { max-width: 1240px; margin: 0 auto; padding: 27px 32px; display: flex; justify-content: space-between; color: #697269; font-size: 11px; }.logo { color: #f4f4ed; font: 700 16px 'Space Grotesk', sans-serif; text-decoration: none; }.logo > span:first-child { display: inline-grid; place-items: center; width: 23px; height: 23px; margin-right: 4px; background: #c9f85b; color: #101212; font-size: 13px; }.dot { color: #c9f85b; }
	@media (max-width: 800px) { .stack-page { padding: 55px 20px 0; }.stack-hero, .stack-details, .details-content { display: block; }.stack-hero h1 { letter-spacing: -3px; }.image-placeholder { min-height: 270px; margin-top: 65px; }.stack-details { margin-top: 85px; padding: 85px 0; }.details-content h2 { margin: 0 0 38px; }.next-step { padding: 70px 0 90px; }.stack-page + footer { padding: 25px 20px; } }
</style>
