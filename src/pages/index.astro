---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { services } from '../data/services';
import { stack } from '../data/stack';
import { imageFolder } from '../data/site';

const companyName = 'Robe Solutions';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const root = `${base}/`;
const slideshowImageCount = 5;
const slideshowIntervalSeconds = 10;
const slideshowImages = Array.from({ length: slideshowImageCount }, (_, index) => `Image_Carousel_${index + 1}.png`);
---

<Layout title={companyName}>
	<SiteHeader />

	<main>
		<section class="hero">
			<div class="hero-copy">
				<p class="eyebrow"><span class="pulse"></span> Data engineering, with intent</p>
				<h1>Make data<br /><em>decisive.</em></h1>
				<p class="intro">We design the infrastructure and intelligence that turns complex business data into your next clear move.</p>
				<div class="hero-actions">
					<a class="button button-primary" href="#contact">Build what’s next <span>↗</span></a>
					<a class="text-link" href="#approach">See how we work <span>↓</span></a>
				</div>
			</div>
			<div class="hero-slideshow" data-interval={slideshowIntervalSeconds * 1000} aria-label="Robe Solutions work highlights">
				<div class="slideshow-frame">
					{slideshowImages.map((imageName, index) => <img class:list={{ active: index === 0 }} data-index={index} src={`${imageFolder}${imageName}`} alt={`Robe Solutions work highlight ${index + 1}`} />)}
				</div>
				<div class="slideshow-dots" aria-label="Choose slideshow image">
					{slideshowImages.map((imageName, index) => <button type="button" data-index={index} class:list={{ active: index === 0 }} aria-label={`Show image ${index + 1}: ${imageName}`}></button>)}
				</div>
			</div>
		</section>

		<section class="proof-bar" aria-label="Trusted by ambitious teams">
			<span>Built for teams moving forward</span><span>Northstar /</span><span>Fieldwork</span><span>Vektor</span><span>+ your next chapter</span>
		</section>

		<section class="approach" id="approach">
			<div class="section-kicker">01 / The approach</div>
			<div class="approach-content"><h2>Clarity is a<br /><em>competitive edge.</em></h2><p>When your data is fragmented, every decision takes longer. We connect the dots, remove the noise, and build systems your team can trust when the stakes are high.</p></div>
		</section>

		<section class="capabilities" id="capabilities">
			<div class="section-kicker">02 / What we do</div>
			<div class="capability-grid">{services.map((service) => <article><span class="number">{service.number}</span><h3>{service.name}</h3><p>{service.short}</p><a href={`${root}services/${service.slug}`}>Explore <span>↗</span></a></article>)}</div>
		</section>

		<section class="stack-section">
			<div class="section-kicker">03 / Our working stack</div>
			<div class="stack-content"><h2>Specialists in the<br /><em>Microsoft data ecosystem.</em></h2><div class="stack-list">{stack.map((item) => <a href={`${root}stack/${item.slug}`}>{item.name}</a>)}</div></div>
		</section>

		<section class="architecture" id="architecture">
			<div class="section-kicker">04 / Reference architecture</div>
			<div class="architecture-intro"><h2>A mature environment,<br /><em>working as one.</em></h2><p>Every platform has a role. Together they create a connected path from operational systems to trusted decisions.</p></div>
			<ImagePlaceholder class="architecture-image" imageName="Reference_Architecture.jpg" alt="Reference data architecture diagram" label="IMAGE / REFERENCE ARCHITECTURE" />
			<div class="architecture-examples">
				<article><span>01</span><h3>Customer sync</h3><p>Using <a href={`${base}stack/azure-data-factory`}>Azure Data Factory</a> and integration services, keep the customer list synchronized between your ERP and <a href={`${base}services/salesforce-development-implementations`}>Salesforce</a>.</p></article>
				<article><span>02</span><h3>Change data capture</h3><p>Use <a href={`${base}stack/qlik-replicate`}>Qlik Replicate</a> to capture changes from Salesforce and ERP systems and land fresh data in the datalake.</p></article>
				<article><span>03</span><h3>Sales data mart</h3><p>Model curated sales data in <a href={`${base}stack/microsoft-fabric`}>Microsoft Fabric</a> so metrics are consistent, governed, and ready for reuse.</p></article>
				<article><span>04</span><h3>Decision layer</h3><p>Let <a href={`${base}stack/power-bi`}>Power BI</a> consume the sales datamart and give commercial teams a shared view of performance.</p></article>
			</div>
		</section>

		<section class="contact" id="contact"><div><p class="eyebrow">Have a hard data problem?</p><h2>Let’s make it<br /><em>legible.</em></h2></div><a class="button button-light" href="mailto:hello@robesolutions.com">hello@robesolutions.com <span>↗</span></a></section>
	</main>

	<footer><span class="logo"><span>R</span> robe<span class="dot">.</span></span><span>Data, made useful.</span><span>© 2026 Robe Solutions</span></footer>
</Layout>

<style>
	@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');

	:global(*) { box-sizing: border-box; }
	:global(html) { scroll-behavior: smooth; }
	.site-header {
		position: relative; z-index: 2;
		display: flex;
		justify-content: space-between;
		align-items: center;
		max-width: 1240px; margin: 0 auto; padding: 30px 32px;
	}

	.logo {
		font-family: 'Space Grotesk', sans-serif; font-weight: 700;
		font-size: 19px; letter-spacing: -1px;
		text-decoration: none;
		color: #f4f4ed;
	}
	.logo > span:first-child { display: inline-grid; place-items: center; width: 25px; height: 25px; margin-right: 4px; background: #c9f85b; color: #101212; font-size: 14px; letter-spacing: 0; }
	.logo .dot { color: #c9f85b; }

	nav {
		display: flex; align-items: center; gap: 31px;
	}

	nav a {
		color: #a5aaa1; text-decoration: none; font-size: 13px; font-weight: 500;
	}
	nav a:hover { color: #f4f4ed; }
	.nav-cta { border: 1px solid #3c413d; padding: 11px 15px; color: #f4f4ed; }
	nav span, .button span, .text-link span, article a span { color: #c9f85b; margin-left: 8px; }

	.hero {
		max-width: 1240px; min-height: 670px; margin: 0 auto; padding: 91px 32px 100px;
		display: grid; grid-template-columns: minmax(0, 1fr) 455px; gap: 80px; align-items: center;
	}
	.hero-copy { animation: rise .8s ease both; }
	.eyebrow, .section-kicker { margin: 0 0 22px; text-transform: uppercase; letter-spacing: 1.5px; font-size: 11px; color: #90978d; font-weight: 700; }
	.pulse, .live i { display: inline-block; width: 7px; height: 7px; margin-right: 8px; border-radius: 50%; background: #c9f85b; box-shadow: 0 0 0 4px rgba(201,248,91,.1); }
	h1, h2, h3 { font-family: 'Space Grotesk', sans-serif; }
	h1 { font-size: clamp(65px, 9vw, 126px); line-height: .9; letter-spacing: -6px; margin: 0 0 32px; color: #f4f4ed; }
	h1 em, h2 em { font-style: normal; color: #c9f85b; }
	.intro { max-width: 475px; margin: 0; color: #a5aaa1; font-size: 17px; line-height: 1.55; }
	.hero-actions { display: flex; align-items: center; gap: 27px; margin-top: 38px; }
	.button { display: inline-flex; align-items: center; padding: 15px 18px; text-decoration: none; font-size: 13px; font-weight: 700; }
	.button-primary { background: #c9f85b; color: #101212; }
	.button-primary span { color: #101212; }
	.text-link { color: #f4f4ed; text-decoration: none; font-size: 13px; font-weight: 600; }
	.hero-note { align-self: stretch; display: flex; flex-direction: column; justify-content: end; padding: 30px 0 14px 30px; border-left: 1px solid #353b35; animation: rise .8s .15s ease both; }.hero-note span { color: #c9f85b; text-transform: uppercase; letter-spacing: 1.3px; font: 600 10px 'Space Grotesk', sans-serif; }.hero-note strong { margin: 16px 0 34px; color: #f4f4ed; font: 500 27px/.98 'Space Grotesk', sans-serif; }.hero-note a { color: #a5aaa1; text-decoration: none; font-size: 12px; font-weight: 700; }.hero-note a span { margin-left: 8px; color: #c9f85b; }
	.signal-panel { background: #1a1e1c; border: 1px solid #353b35; padding: 22px; box-shadow: 25px 25px 0 rgba(201,248,91,.08); animation: rise .8s .15s ease both; }
	.panel-top, .panel-bottom { display: flex; justify-content: space-between; color: #697269; font: 600 9px 'Space Grotesk', sans-serif; letter-spacing: 1.3px; }
	.live { color: #a5aaa1; }.live i { width: 5px; height: 5px; margin-right: 5px; box-shadow: none; }
	.metric-row { display: flex; justify-content: space-between; align-items: end; padding: 57px 0 31px; }.metric-label { display: block; color: #7f897e; font-size: 11px; margin-bottom: 10px; }.metric-row strong { display: block; color: #f4f4ed; font: 600 44px 'Space Grotesk', sans-serif; letter-spacing: -2px; }.metric-row small { color: #c9f85b; font-size: 10px; }
	.chart { width: 150px; height: 61px; display: flex; align-items: end; gap: 4px; }.chart span { flex: 1; background: #5d7242; }.chart span:nth-child(1){height:28%}.chart span:nth-child(2){height:39%}.chart span:nth-child(3){height:34%}.chart span:nth-child(4){height:49%}.chart span:nth-child(5){height:44%}.chart span:nth-child(6){height:62%}.chart span:nth-child(7){height:57%}.chart span:nth-child(8){height:70%}.chart span:nth-child(9){height:66%}.chart span:nth-child(10){height:82%;background:#c9f85b}.chart span:nth-child(11){height:76%;background:#c9f85b}.chart span:nth-child(12){height:100%;background:#c9f85b}
	.panel-rule { height: 1px; background: #353b35; }.board-grid { display: grid; grid-template-columns: repeat(3, 1fr); padding: 31px 0 38px; gap: 15px; }.board-grid strong { font: 500 27px 'Space Grotesk', sans-serif; color: #f4f4ed; }.accent { color: #c9f85b; }.unit { color: #697269; font-size: 13px; letter-spacing: 0; margin-left: 3px; }.panel-bottom b { color: #c9f85b; }
	.proof-bar { max-width: 1240px; margin: 0 auto; padding: 21px 32px; border-top: 1px solid #2d322f; border-bottom: 1px solid #2d322f; display: flex; justify-content: space-between; color: #626a61; font: 600 11px 'Space Grotesk', sans-serif; }.proof-bar span:first-child { color: #9ba29a; }.proof-bar span:not(:first-child) { font-size: 14px; letter-spacing: -0.5px; }
	.approach, .capabilities { max-width: 1240px; margin: 0 auto; padding: 135px 32px; }.approach { display: grid; grid-template-columns: 1fr 2fr; gap: 80px; }.section-kicker { color: #c9f85b; }.approach-content { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; }.approach h2 { font-size: clamp(39px, 5vw, 67px); line-height: .96; letter-spacing: -3px; margin: -8px 0 0; }.approach-content p { color: #9ca49a; line-height: 1.7; font-size: 16px; margin: 0; max-width: 340px; }
	.capabilities { border-top: 1px solid #2d322f; }.capability-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }.capability-grid article { border-top: 1px solid #4a5149; padding: 22px 26px 0 0; min-height: 245px; }.capability-grid article + article { border-left: 1px solid #2d322f; padding-left: 26px; }.number { color: #6f796d; font: 11px 'Space Grotesk', sans-serif; }.capability-grid h3 { color: #f4f4ed; font-size: 20px; font-weight: 500; margin: 50px 0 14px; }.capability-grid p { color: #8d968b; max-width: 280px; font-size: 14px; line-height: 1.6; }.capability-grid a { display: block; margin-top: 24px; color: #f4f4ed; text-decoration: none; font-size: 12px; font-weight: 700; }
	.capabilities { border-top: 1px solid #2d322f; }.capability-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }.capability-grid article { border-top: 1px solid #4a5149; padding: 22px 26px 0 0; min-height: 245px; }.capability-grid article + article { border-left: 1px solid #2d322f; padding-left: 26px; }.number { color: #6f796d; font: 11px 'Space Grotesk', sans-serif; }.capability-grid h3 { color: #f4f4ed; font-size: 20px; font-weight: 500; margin: 50px 0 14px; }.capability-grid p { color: #8d968b; max-width: 280px; font-size: 14px; line-height: 1.6; }.capability-grid a { display: block; margin-top: 24px; color: #f4f4ed; text-decoration: none; font-size: 12px; font-weight: 700; }
	.capability-grid article { display: flex; flex-direction: column; align-items: center; padding: 22px 20px 28px; text-align: center; }.capability-grid article + article { padding-left: 20px; }.capability-grid article h3 { width: 100%; }.capability-grid article p { margin-left: auto; margin-right: auto; }.capability-grid article a { margin-top: auto; }
	.stack-section { max-width: 1240px; margin: 0 auto; padding: 0 32px 135px; }.stack-content { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; }.stack-content h2 { margin: -8px 0 0; color: #f4f4ed; font: 500 clamp(39px, 5vw, 67px)/.96 'Space Grotesk', sans-serif; letter-spacing: -3px; }.stack-content em { color: #c9f85b; font-style: normal; }.stack-list { display: flex; flex-wrap: wrap; align-content: start; gap: 10px; }.stack-list a { padding: 12px 14px; border: 1px solid #3b433a; color: #d4d8cf; font-size: 13px; text-decoration: none; }.stack-list a:hover { color: #c9f85b; border-color: #c9f85b; }
	.architecture { max-width: 1240px; margin: 0 auto; padding: 0 32px 135px; }.architecture-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; }.architecture-intro h2 { margin: -8px 0 0; color: #f4f4ed; font: 500 clamp(39px, 5vw, 67px)/.96 'Space Grotesk', sans-serif; letter-spacing: -3px; }.architecture-intro em { color: #c9f85b; font-style: normal; }.architecture-intro p { max-width: 340px; color: #9ca49a; line-height: 1.7; font-size: 16px; }.architecture-image { min-height: 410px; margin: 70px 0 0; padding: 27px; display: flex; flex-direction: column; justify-content: end; background: repeating-linear-gradient(135deg, #1b201d, #1b201d 2px, #202621 2px, #202621 4px); border: 1px solid #3a4239; box-shadow: 20px 20px 0 rgba(201,248,91,.08); }.architecture-image span { margin-bottom: auto; color: #697269; font: 600 9px 'Space Grotesk', sans-serif; letter-spacing: 1.3px; }.architecture-image strong { color: #f4f4ed; font: 500 25px 'Space Grotesk', sans-serif; }.architecture-image small { margin-top: 10px; color: #8c968a; }.architecture-image code { color: #c9f85b; }.architecture-examples { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin-top: 55px; }.architecture-examples article { padding: 20px 22px 0 0; border-top: 1px solid #4a5149; }.architecture-examples article + article { padding-left: 22px; border-left: 1px solid #2d322f; }.architecture-examples span { color: #c9f85b; font: 11px 'Space Grotesk', sans-serif; }.architecture-examples h3 { margin: 38px 0 13px; color: #f4f4ed; font: 500 19px 'Space Grotesk', sans-serif; }.architecture-examples p { color: #8d968b; font-size: 13px; line-height: 1.6; }.architecture-examples a { color: #c9f85b; text-decoration: none; }
	.contact { background: #c9f85b; color: #101212; padding: 91px max(32px, calc((100vw - 1176px) / 2)); display: flex; justify-content: space-between; align-items: end; }.contact .eyebrow { color: #4f652c; margin-bottom: 24px; }.contact h2 { font-size: clamp(54px, 7vw, 92px); line-height: .88; letter-spacing: -4px; margin: 0; }.button-light { background: #101212; color: #f4f4ed; margin-bottom: 3px; }.button-light span { color: #c9f85b; }
	footer { max-width: 1240px; margin: 0 auto; padding: 27px 32px; display: flex; justify-content: space-between; color: #697269; font-size: 11px; } footer .logo { font-size: 15px; }
	@keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
	@media (max-width: 800px) { .site-header { padding: 22px 20px; } nav a:not(.nav-cta) { display: none; } .nav-cta { padding: 9px 11px; }.hero { display: block; padding: 70px 20px 80px; min-height: auto; }.hero h1 { letter-spacing: -3px; font-size: clamp(62px, 18vw, 100px); }.hero-note { min-height: 175px; margin-top: 70px; padding-left: 22px; }.proof-bar { padding: 18px 20px; gap: 18px; overflow: hidden; }.proof-bar span:nth-child(1), .proof-bar span:nth-child(5) { display: none; }.approach, .capabilities, .stack-section, .architecture { display: block; padding: 85px 20px; }.approach-content, .stack-content, .architecture-intro { display: block; }.approach-content p, .architecture-intro p { margin-top: 35px; }.stack-list { margin-top: 35px; }.architecture-image { min-height: 300px; margin-top: 50px; }.architecture-examples { display: block; margin-top: 40px; }.architecture-examples article, .architecture-examples article + article { border-left: 0; padding: 22px 0; }.capability-grid { display: block; }.capability-grid article, .capability-grid article + article { border-left: 0; padding: 22px 0; min-height: auto; }.capability-grid h3 { margin-top: 35px; }.contact { display: block; padding: 70px 20px; }.button-light { margin-top: 42px; }.contact h2 { letter-spacing: -3px; }.contact + footer { padding: 25px 20px; gap: 15px; flex-wrap: wrap; }.contact + footer > span:last-child { width: 100%; } }
	.hero-slideshow { align-self: stretch; }
	.slideshow-frame { position: relative; min-height: 390px; overflow: hidden; border: 1px solid #3a4239; border-radius: 18px; box-shadow: 0 18px 45px rgba(16,18,18,.22), 0 10px 25px rgba(201,248,91,.1); }
	.slideshow-frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .8s ease; }
	.slideshow-frame img.active { opacity: 1; }
	.slideshow-dots { display: flex; justify-content: center; gap: 9px; padding-top: 18px; }
	.slideshow-dots button { width: 9px; height: 9px; padding: 0; border: 1px solid #697269; border-radius: 50%; background: transparent; cursor: pointer; }
	.slideshow-dots button.active { background: #c9f85b; border-color: #c9f85b; }
	.slideshow-dots button:disabled { opacity: .3; cursor: not-allowed; }
	.slideshow-dots button:focus-visible { outline: 2px solid #c9f85b; outline-offset: 4px; }
</style>

<script>
	const slideshow = document.querySelector<HTMLElement>('.hero-slideshow');
	const slideshowImages: HTMLImageElement[] = slideshow ? Array.from(slideshow.querySelectorAll<HTMLImageElement>('.slideshow-frame img')) : [];
	const slideshowDots: HTMLButtonElement[] = slideshow ? Array.from(slideshow.querySelectorAll<HTMLButtonElement>('.slideshow-dots button')) : [];
	const slideshowInterval = Number(slideshow?.dataset.interval ?? 10000);
	let activeImageIndex = 0;

	const showSlideshowImage = (imageIndex: number) => {
		activeImageIndex = imageIndex;
		slideshowImages.forEach((image, index) => image.classList.toggle('active', index === activeImageIndex && !image.hidden));
		slideshowDots.forEach((dot, index) => dot.classList.toggle('active', index === activeImageIndex));
	};

	slideshowImages.forEach((image, index) => image.addEventListener('error', () => {
		image.hidden = true;
		slideshowDots[index].disabled = true;
		if (index === activeImageIndex) {
			const nextAvailableIndex = slideshowImages.findIndex((candidate) => !candidate.hidden);
			if (nextAvailableIndex >= 0) showSlideshowImage(nextAvailableIndex);
		}
	}));
	slideshowDots.forEach((dot, index) => dot.addEventListener('click', () => showSlideshowImage(index)));

	if (slideshowImages.length > 1) {
		setInterval(() => {
			const availableImages = slideshowImages.filter((image) => !image.hidden);
			if (availableImages.length < 2) return;
			const activeAvailableIndex = availableImages.findIndex((image) => image.classList.contains('active'));
			showSlideshowImage(slideshowImages.indexOf(availableImages[(activeAvailableIndex + 1) % availableImages.length]));
		}, slideshowInterval);
	}
</script>