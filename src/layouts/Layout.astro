---
interface Props {
	title?: string;
}

const { title = 'Your Company' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Robe Solutions builds dependable data platforms for teams that need better answers, faster." />
		<script is:inline>
			const savedTheme = localStorage.getItem('robe-theme');
			document.documentElement.dataset.theme = savedTheme === 'dark' ? 'dark' : 'light';
		</script>
		<title>{title}</title>
	</head>

	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root { --color-main: #172018; }
	html, body { margin: 0; width: 100%; min-height: 100%; }
	body { font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif; color: #172018; background: #f5f7f1; transition: background-color .2s ease, color .2s ease; }
	html[data-theme='dark'] body { color: #f4f4ed; background: #101212; }
	html[data-theme='light'] .site-header .logo, html[data-theme='light'] .site-header nav a, html[data-theme='light'] .site-header nav button, html[data-theme='light'] .site-header .nav-cta { color: #172018 !important; }
	html[data-theme='light'] .site-header .nav-cta { border-color: #cfd6ca; }
	html[data-theme='light'] .dropdown { background: #fff; border-color: #d8e0d4; box-shadow: 12px 12px 0 rgba(83,113,58,.12); }
	html[data-theme='light'] .dropdown a { color: #172018 !important; border-color: #e3e8df; }
	html[data-theme='light'] h1, html[data-theme='light'] h2, html[data-theme='light'] h3, html[data-theme='light'] .hero-note strong, html[data-theme='light'] .image-placeholder strong, html[data-theme='light'] .architecture-image strong { color: #172018 !important; }
	html[data-theme='light'] .intro, html[data-theme='light'] .lead, html[data-theme='light'] .approach-content p, html[data-theme='light'] .capability-grid p, html[data-theme='light'] .hero-note a, html[data-theme='light'] footer, html[data-theme='light'] .architecture-intro p, html[data-theme='light'] .architecture-examples p { color: #5f6b5e !important; }
	html[data-theme='light'] .text-link { color: #172018 !important; }
	html[data-theme='light'] .proof-bar, html[data-theme='light'] .approach, html[data-theme='light'] .capabilities, html[data-theme='light'] .architecture, html[data-theme='light'] .stack-section, html[data-theme='light'] .hero-note { border-color: #d8e0d4; }
	html[data-theme='light'] .capability-grid article, html[data-theme='light'] .architecture-examples article { border-color: #bdc9b9; }
	html[data-theme='light'] .stack-list a { color: #344235; border-color: #bdc9b9; }
	html[data-theme='light'] .architecture-image, html[data-theme='light'] .image-placeholder { background: repeating-linear-gradient(135deg,#e8eee4,#e8eee4 2px,#f2f5ef 2px,#f2f5ef 4px); border-color: #bdc9b9; box-shadow: 20px 20px 0 rgba(83,113,58,.12); }
	html[data-theme='light'] .contact { color: #172018; }
	html[data-theme='light'] .button-light { background: #172018; color: #f5f7f1 !important; }
	html[data-theme='light'] .points p { color: #344235 !important; }
	html[data-theme='light'] .image-placeholder small, html[data-theme='light'] .architecture-image small { color: #5f6b5e; }
	html[data-theme='light'] .signal-panel { background: #fff; border-color: #d8e0d4; box-shadow: 25px 25px 0 rgba(83,113,58,.12); }
	html[data-theme='light'] .signal-panel .metric-row strong, html[data-theme='light'] .signal-panel .board-grid strong, html[data-theme='light'] .signal-panel .panel-top, html[data-theme='light'] .signal-panel .panel-bottom { color: #172018 !important; }
	html[data-theme='light'] .panel-rule { background: #d8e0d4 !important; }
	/* Small accents need more contrast than the display-sized lime headline. */
	html[data-theme='light'] .eyebrow, html[data-theme='light'] .section-kicker, html[data-theme='light'] .hero-note > span, html[data-theme='light'] nav button span, html[data-theme='light'] .dropdown span, html[data-theme='light'] .text-link span, html[data-theme='light'] article a span, html[data-theme='light'] .architecture-examples > article > span, html[data-theme='light'] .stack-row > span, html[data-theme='light'] .stack-row a, html[data-theme='light'] .accent { color: #456b1f !important; text-shadow: none; }
	html[data-theme='light'] .theme-toggle { color: #172018 !important; border-color: #9daf94 !important; }
	/* The lime accent stays bright, with a small edge that keeps it legible on pale surfaces. */
	.eyebrow, .section-kicker, .logo .dot, .accent, .text-link span, article a span, .stack-list a:hover, .stack-row a { text-shadow: 0 1px 0 rgba(23, 32, 24, .42); }
	h1 em, h2 em { text-shadow: none; -webkit-text-stroke: 2px #000; paint-order: stroke fill; }
	html[data-theme='light'] .eyebrow, html[data-theme='light'] .section-kicker, html[data-theme='light'] .hero-note > span { display: inline-block; padding: 5px 8px; background: #172018; color: #e3ff9a !important; font-size: 12px; letter-spacing: 1px; }
	html[data-theme='light'] nav button span, html[data-theme='light'] .dropdown span, html[data-theme='light'] .text-link span, html[data-theme='light'] article a span, html[data-theme='light'] .architecture-examples > article > span, html[data-theme='light'] .stack-row > span, html[data-theme='light'] .accent { color: #355919 !important; font-size: 1.08em; font-weight: 700; }
	html[data-theme='light'] .theme-toggle { background: #172018 !important; color: #f5f7f1 !important; border: 2px solid #172018 !important; }
	html[data-theme='light'] .stack-list a { background: #172018; color: #f5f7f1 !important; border: 2px solid #172018; font-weight: 600; }
	html[data-theme='light'] .stack-list a:hover { background: #456b1f; color: #ffffff !important; border-color: #456b1f; text-shadow: none; }
	html[data-theme='light'] .stack-row a { background: #e3ff9a; padding: 2px 5px; color: #294414 !important; text-shadow: none; }
	html[data-theme='light'] .contact h2 em { color: #172018 !important; text-shadow: none; }
	html[data-theme='dark'] .contact h2 em { color: #172018 !important; text-shadow: none; -webkit-text-stroke: 0; }
	html[data-theme='light'] .contact .eyebrow { background: #172018; color: #e3ff9a !important; }
	html[data-theme='light'] .eyebrow, html[data-theme='light'] .section-kicker, html[data-theme='light'] h1 em, html[data-theme='light'] h2 em, html[data-theme='light'] .logo .dot, html[data-theme='light'] .accent, html[data-theme='light'] .text-link span, html[data-theme='light'] article a span, html[data-theme='light'] .stack-list a:hover, html[data-theme='light'] .stack-row a { text-shadow: 0 1px 0 rgba(23, 32, 24, .58); }
	html[data-theme='light'] .eyebrow, html[data-theme='light'] .section-kicker, html[data-theme='light'] .hero-note > span, html[data-theme='light'] nav button span, html[data-theme='light'] .dropdown span, html[data-theme='light'] .text-link span, html[data-theme='light'] article a span, html[data-theme='light'] .architecture-examples > article > span, html[data-theme='light'] .stack-row > span, html[data-theme='light'] .stack-row a, html[data-theme='light'] .accent { color: #456b1f !important; text-shadow: none; }
	html[data-theme='light'] .hero-note > span, html[data-theme='light'] .section-kicker, html[data-theme='light'] .eyebrow { color: #e3ff9a !important; font-size: 12px !important; }
	html[data-theme='light'] nav button span { display: inline-block; padding: 1px 4px; background: #172018; color: #e3ff9a !important; }
	html[data-theme='light'] .theme-toggle span { padding: 0; background: transparent; color: #f5f7f1 !important; }
	html[data-theme='light'] .stack-list a { border-width: 2px !important; }
	html[data-theme='light'] .approach .section-kicker, html[data-theme='light'] .capabilities .section-kicker { align-self: start; justify-self: start; width: max-content; height: fit-content; }
	html[data-theme='light'] .theme-toggle { background: transparent !important; color: #172018 !important; border: 2px solid #6f8468 !important; }
	html[data-theme='light'] .theme-toggle span { color: #172018 !important; }
	html[data-theme='light'] nav button span { padding: 0; background: transparent; color: #355919 !important; }
	html[data-theme='light'] .proof-bar span:first-child { color: #344235 !important; }
	html[data-theme='light'] .capability-grid article { border: 1px solid #aebda8 !important; border-right: 0 !important; border-bottom: 0 !important; }
	html[data-theme='light'] .capability-grid article:nth-child(4n) { border-right: 1px solid #aebda8 !important; }
	html[data-theme='light'] .capability-grid article:nth-child(n + 5) { border-bottom: 1px solid #aebda8 !important; }
	html[data-theme='light'] .capability-grid article { box-shadow: inset 0 0 0 1px #aebda8; }
	html[data-theme='light'] .architecture-examples a { display: inline-block; padding: 1px 4px; background: #e3ff9a; color: #294414 !important; font-weight: 700; text-shadow: none; }
	html[data-theme='light'] footer .logo { color: #172018 !important; }
	html[data-theme='light'] footer .logo > span:first-child { color: #172018 !important; }
	html[data-theme='light'] h1 em, html[data-theme='light'] h2 em { color: #c9f85b !important; text-shadow: none; -webkit-text-stroke: 2px #000; paint-order: stroke fill; }
	.theme-toggle { padding: 3px !important; }
	.theme-toggle .theme-option { display: block; margin: 0 !important; padding: 7px 9px !important; font: 600 10px 'DM Sans', sans-serif; }
	html[data-theme='light'] .theme-toggle .theme-option.light { background: #f4f4ed; color: #172018 !important; }
	html[data-theme='light'] .theme-toggle .theme-option.dark { background: transparent; color: #5f6b5e !important; }
	html[data-theme='dark'] .theme-toggle .theme-option.light { background: transparent; color: #a5aaa1 !important; }
	html[data-theme='dark'] .theme-toggle .theme-option.dark { background: #c9f85b; color: #172018 !important; }
	html[data-theme='light'] .capability-grid article a { color: #172018 !important; }
	html[data-theme='light'] .capability-grid article a span { color: #355919 !important; }
	.capability-grid { gap: 1px; }
	.capability-grid article { border: 0 !important; }
	.capability-grid article + article { border-left: 0 !important; padding-left: 26px; }
	.capability-grid { background: #4a5149; border: 1px solid #4a5149; }
	.capability-grid article { background: #101212; }
	html[data-theme='light'] .capability-grid { background: #aebda8; border: 1px solid #aebda8; }
	html[data-theme='light'] .capability-grid article { background: #f5f7f1; box-shadow: none; }
	html[data-theme='light'] .capability-grid article:nth-child(4n) { border-right: 0 !important; }
	html[data-theme='light'] .capability-grid article:nth-child(n + 5) { border-bottom: 0 !important; }
</style>