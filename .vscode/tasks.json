{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Check Git installation",
			"type": "shell",
			"command": "git",
			"args": [
				"--version"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install Git for publishing",
			"type": "shell",
			"command": "winget",
			"args": [
				"install",
				"--id",
				"Git.Git",
				"--exact",
				"--accept-source-agreements",
				"--accept-package-agreements"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify publishing tools",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"& 'C:\\Program Files\\Git\\cmd\\git.exe' --version; & 'C:\\Program Files\\GitHub CLI\\gh.exe' --version; & 'C:\\Program Files\\GitHub CLI\\gh.exe' auth status"
			],
			"isBackground": false,
			"problemMatcher": []
		},
